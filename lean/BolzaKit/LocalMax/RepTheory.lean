/-! ### 1. P-conjugation (original cert_chars basis ↔ block basis) -/

theorem P_invertible : mul6 P Pinv2 = smul 2 I6 := by decide +kernel
theorem conj_r : mul6 R6 P = mul6 P (blk gR.m gR.p) := by decide +kernel
theorem conj_t : mul6 T6x2 P = mul6 P (smul 2 (blk gT.m gT.p)) := by decide +kernel
theorem conj_k : mul6 K6 P = mul6 P (blk gK.m gK.p) := by decide +kernel
/-- a acts by −1 on T₋ = span(b₁,b₂,b₃) and by +1 on T₊ = span(c₁,c₂,c₃). -/
theorem conj_a : mul6 A6 P = mul6 P (blk negI3 I3) := by decide +kernel

/-! ### 2. a is a word in the generators: 8·A6 = R6·R6·(2T6)·(2T6)·K6·(2T6) -/
theorem a_is_word :
    mul6 (mul6 (mul6 (mul6 (mul6 R6 R6) T6x2) T6x2) K6) T6x2 = smul 8 A6 := by decide +kernel

/-! ### 3. The group H -/

theorem Hlist_length : Hlist.length = 48 := by decide +kernel
theorem one_mem_H : oneQ ∈ Hlist := by decide +kernel
theorem H_closed : ∀ h ∈ Hlist, ∀ s ∈ gens, mulQ h s ∈ Hlist := by decide +kernel
theorem H_words : (Hlist.zip Hwords).all (fun hw => evalWord hw.2 == hw.1) = true := by decide +kernel
theorem Hwords_length : Hwords.length = 48 := by decide +kernel
/-- the (X₋, X₊) projection is injective on H, so H ≅ image of G in GL(T_B). -/
theorem H_proj_nodup : (Hlist.map fun h => (h.m, h.p)).Nodup := by decide +kernel

/-- The monoid generated by the generator tuples. -/
inductive InH : Q → Prop
  | one : InH oneQ
  | mul {h : Q} (s : Gen) : InH h → InH (mulQ h s.val)

theorem InH_foldl (w : List Gen) : ∀ acc, InH acc → InH (w.foldl (fun acc g => mulQ acc g.val) acc) := by
  induction w with
  | nil => intro acc h; exact h
  | cons s w ih => intro acc h; exact ih _ (InH.mul s h)

theorem InH_evalWord (w : List Gen) : InH (evalWord w) := InH_foldl w _ InH.one

theorem gen_mem (s : Gen) : s.val ∈ gens := by cases s <;> decide +kernel

/-- **H is exactly the generated group** (as a set): `InH q ↔ q ∈ Hlist`. -/
theorem InH_iff (q : Q) : InH q ↔ q ∈ Hlist := by
  constructor
  · intro h
    induction h with
    | one => exact one_mem_H
    | mul s _ ih => exact H_closed _ ih _ (gen_mem s)
  · intro hq
    have hall := H_words
    rw [List.all_eq_true] at hall
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hq
    have hi' : i < (Hlist.zip Hwords).length := by simp [Hwords_length, Hlist_length] at hi ⊢; omega
    have := hall _ (List.getElem_mem hi')
    simp only [List.getElem_zip, beq_iff_eq] at this
    rw [← this]
    exact InH_evalWord _

/-! ### 4. Characters -/

def chiM (h : Q) : Int := tr3 h.m          -- χ₋ = χ_{K₀} = X₁
def chiP (h : Q) : Int := tr3 h.p          -- χ₊ = χ_{W₀} = X₂
def chiT (h : Q) : Int := chiM h + chiP h  -- χ_T
def chiO (h : Q) : Int := tr3 h.o          -- octahedral
def chiOe (h : Q) : Int := h.e * tr3 h.o   -- octahedral ⊗ orientation

/-- Σ_{h ∈ H} f(h) -/
def sumH (f : Q → Int) : Int := (Hlist.map f).sum

theorem chiT_one_ip : sumH chiT = 0 := by decide +kernel
theorem chiT_norm : sumH (fun h => chiT h * chiT h) = 2 * 48 := by decide +kernel
theorem chiM_norm : sumH (fun h => chiM h * chiM h) = 48 := by decide +kernel
theorem chiP_norm : sumH (fun h => chiP h * chiP h) = 48 := by decide +kernel
theorem chiM_chiP : sumH (fun h => chiM h * chiP h) = 0 := by decide +kernel
theorem chiO_norm : sumH (fun h => chiO h * chiO h) = 48 := by decide +kernel
theorem chiOe_norm : sumH (fun h => chiOe h * chiOe h) = 48 := by decide +kernel
/-- the four 3-dimensional candidates are pairwise orthogonal -/
theorem candidates_orthogonal :
    sumH (fun h => chiM h * chiO h) = 0 ∧ sumH (fun h => chiM h * chiOe h) = 0 ∧
    sumH (fun h => chiP h * chiO h) = 0 ∧ sumH (fun h => chiP h * chiOe h) = 0 ∧
    sumH (fun h => chiO h * chiOe h) = 0 := by decide +kernel
/-- traces on T_B of r, r², J(=1 in H), t: −2, −2, 6, 0 (PROOF Lemma 6(ii)). -/
theorem chiT_values :
    chiT gR = -2 ∧ chiT (mulQ gR gR) = -2 ∧ chiT oneQ = 6 ∧ chiT gT = 0 := by decide +kernel
/-- χ_T vanishes on orientation-reversing elements. -/
theorem chiT_reversing : ∀ h ∈ Hlist, h.e = -1 → chiT h = 0 := by decide +kernel

/-- 2·χ_{Sym₀²E}(h) = χ(h)² + χ(h²) − 2, for E given by a component selector. -/
def twoSym0 (chi : Q → Int) (h : Q) : Int := chi h * chi h + chi (mulQ h h) - 2

/-- **Sym₀²E ∌ K₀ and Sym₀²E ⊇ W₀ once**, for each of the four candidates for E
(E = X₁, X₂, O, O·ε).  Stated as Σ 2χ_{Sym₀²E}·χ_{K₀} = 0 and Σ 2χ_{Sym₀²E}·χ_{W₀} = 2·|H|. -/
theorem sym0_X1_K0 : sumH (fun h => twoSym0 chiM h * chiM h) = 0 := by decide +kernel
theorem sym0_X1_W0 : sumH (fun h => twoSym0 chiM h * chiP h) = 2 * 48 := by decide +kernel
theorem sym0_X2_K0 : sumH (fun h => twoSym0 chiP h * chiM h) = 0 := by decide +kernel
theorem sym0_X2_W0 : sumH (fun h => twoSym0 chiP h * chiP h) = 2 * 48 := by decide +kernel
theorem sym0_O_K0 : sumH (fun h => twoSym0 chiO h * chiM h) = 0 := by decide +kernel
theorem sym0_O_W0 : sumH (fun h => twoSym0 chiO h * chiP h) = 2 * 48 := by decide +kernel
theorem sym0_Oe_K0 : sumH (fun h => twoSym0 chiOe h * chiM h) = 0 := by decide +kernel
theorem sym0_Oe_W0 : sumH (fun h => twoSym0 chiOe h * chiP h) = 2 * 48 := by decide +kernel

/-! ### 5. Lemma 7, exact part, for every s_mid-type reflection -/

/-- number of Weierstrass points fixed (2 per +1 diagonal entry of the signed permutation). -/
def nFixW (h : Q) : Int :=
  2 * ((if getM 3 h.o 0 0 = 1 then 1 else 0) + (if getM 3 h.o 1 1 = 1 then 1 else 0) +
    (if getM 3 h.o 2 2 = 1 then 1 else 0))

def IsSmidType (h : Q) : Bool :=
  h.e == -1 && mulQ h h == oneQ && mulQ (mulQ h gR) h == mulQ (mulQ gR gR) gR && nFixW h == 4

/-- The (−1)-eigenspace of X(r) in each block is the line of the middle basis vector
(X(r) = [[0,0,−1],[0,−1,0],[1,0,0]] in both blocks), so {r v = −v} = span(e₁⁻, e₁⁺).
For every s_mid-type reflection s, s fixes e₁⁻ and negates e₁⁺: hence
{r v = −v, s v = v} = span(e₁⁻) ⊂ T₋ = K₀. -/
theorem smid_line_in_Kminus :
    (Hlist.filter IsSmidType).length = 2 ∧
    ∀ h ∈ Hlist, IsSmidType h = true →
      (getM 3 h.m 0 1 = 0 ∧ getM 3 h.m 1 1 = 1 ∧ getM 3 h.m 2 1 = 0) ∧ getM 3 h.p 1 1 = -1 := by
  decide +kernel

theorem gK_is_smid : IsSmidType gK = true := by decide +kernel

end Bolza.Rep
